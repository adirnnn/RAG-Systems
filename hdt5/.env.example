# copia este archivo a ".env" y completa los valores
# el ".env" esta en el .gitignore, nunca se sube al repo

# hdt5 reutiliza la misma base pgvector que levanta y llena hdt4 (no trae la
# suya propia). antes de correr cualquier programa de hdt5 hay que tener
# arriba: cd ../hdt4 && docker compose up -d
DATABASE_URL=postgresql://parachute:parachute@localhost:5434/parachute

# credenciales de groq, la consola es gratis y no pide tarjeta: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# modelo del llm para los agentes. con arquitecturas de varios niveles cada
# turno puede implicar varias llamadas anidadas, asi que por defecto se usa el
# modelo mas rapido (20b). se puede subir a 120b si se quiere mas calidad
GROQ_MODEL=openai/gpt-oss-20b

# mismo modelo de embeddings que uso hdt4/cargar.py para llenar la tabla faqs,
# tiene que coincidir o los vectores no se pueden comparar
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# umbral de similitud coseno del filtro grueso de la herramienta de faqs
UMBRAL_SIMILITUD=0.35
