# copia este archivo a ".env" y completa los valores
# el ".env" esta en el .gitignore, nunca se sube al repo

# conexion a la base postgres con pgvector (la que levanta docker compose)
DATABASE_URL=postgresql://parachute:parachute@localhost:5434/parachute

# credenciales de groq, la consola es gratis y no pide tarjeta: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# modelo del llm que responde y usa la herramienta (soporta function calling)
GROQ_MODEL=openai/gpt-oss-120b

# modelo de embeddings, corre local en CPU, sigue siendo chico (384 dimensiones).
# se usa la variante multilingue porque all-MiniLM-L6-v2 es casi solo ingles y en
# espanol se enganchaba a palabras sueltas en vez del significado
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ruta al corpus de faqs que llena la tabla
CORPUS_FILE=../Corpus_FAQs_Parachute_SA_2026.txt

# umbral de similitud coseno para el filtro grueso de la herramienta. con el
# modelo multilingue las preguntas del dominio quedan sobre 0.45 y las que no
# tienen nada que ver por debajo de 0.25, asi que 0.35 separa bien
UMBRAL_SIMILITUD=0.35
