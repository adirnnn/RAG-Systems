# copia este archivo a ".env" y pon tu api key de verdad
# el archivo ".env" está en el .gitignore y nunca se sube al repo

# api key de groq, la consola es gratis y no pide tarjeta: https://console.groq.com/keys
GROQ_API_KEY=

# endpoint que es compatible con la api de openai
GROQ_BASE_URL=https://api.groq.com/openai/v1

# modelo que se va a usar, el catálogo está en https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# opcional: otra ruta al archivo de preguntas frecuentes por si lo quiero mover
# FAQ_FILE=FAQs_Parachute_SA_Guatemala_2026.txt
