# Copia este archivo a ".env" y coloca tu API Key real.
# El archivo ".env" está en .gitignore y NUNCA debe subirse al repositorio.

# API Key de Groq (consola gratuita, sin tarjeta): https://console.groq.com/keys
GROQ_API_KEY=

# Endpoint compatible con la API de OpenAI
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Modelo a utilizar
GROQ_MODEL=llama-3.3-70b-versatile

# (Opcional) Ruta alternativa al archivo de preguntas frecuentes
# FAQ_FILE=FAQs_Parachute_SA_Guatemala_2026.txt
